# This file is an example; the service does not read the repository's legacy .env.
# Export these variables in the process environment or use uvicorn --env-file.
RAG_API_TOKEN=replace-with-a-long-random-backend-token
RAG_TENANT_ID=local
RAG_ALLOW_LOCAL=0
RAG_DB_PATH=data/rag/index.db
RAG_DEVICE=cpu
RAG_TORCH_THREADS=4
GEMINI_API_KEY=replace-with-your-api-key
# Set RAG_DENSE_MIN_SCORE after calibration on Gemini dev queries, not E5's 0.82.
# RAG_DENSE_MIN_SCORE=your-calibrated-threshold
