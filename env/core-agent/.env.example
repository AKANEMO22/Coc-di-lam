# --- Đổi LLM sang Google Gemini (API key) ---
# Bỏ dấu # ở 5 dòng dưới và comment 3 dòng LLM_* ở đầu file. Key dùng chung với GEMINI_API_KEY của core-tts-stt.
# Speaker (câu hỏi realtime) dùng flash-lite để có chữ đầu ~1 s; các agent khác dùng gemini-3.5-flash.
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-3.6-flash
# LLM_REASONING_EFFORT=medium
# AGENT_PROFILES_OVERRIDES='{"speaker": {"model": "gemini-3.5-flash-lite"}}'

# ID_Q / RAG_CocDiLam: root compose passes these to core, gateway and rag-idq. Two different long random values.
RAG_IDQ_API_TOKEN=replace-with-a-long-random-idq-api-token
RAG_CORE_TOKEN=replace-with-a-different-long-random-core-token

# Edge (nginx) login for admin tools on ports 8031-8035 (root compose / CT 104). Required.
EDGE_ADMIN_USER=admin
EDGE_ADMIN_PASSWORD=replace-with-a-long-random-password
