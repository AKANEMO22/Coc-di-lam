# --- Core AI (core_agent) ---
CORE_URL=http://127.0.0.1:8001
# Must equal the core JWT_SECRET. The gateway signs its own service tokens with it; the browser never sees it.
# Replace the placeholder before running the gateway.
CORE_JWT_SECRET=local-compose-development-secret-change-before-production
# = MAX_ANSWER_CHARS of the core: one answer plus the text of documents attached to it
MAX_ANSWER_CHARS=20000

# --- Speech service (core-tts-stt) ---
SPEECH_URL=http://127.0.0.1:8010
# = SERVICE_TOKEN of the speech service, when it sets one
SPEECH_SERVICE_TOKEN=
# Comma-separated BCP-47 codes, or "auto"
STT_LANGUAGE=vi-VN
# Empty = speech service default voice
TTS_VOICE=
# false = text only, the interviewer is not read aloud
TTS_ENABLED=true

# --- ID_Q / RAG service (RAG_CocDiLam) ---
# CV or form intake goes here first; core then loads the prepared knowledge pack by id.
RAG_URL=http://127.0.0.1:8200
# = RAG_IDQ_API_TOKEN of the RAG service (and of core)
RAG_API_TOKEN=
# auto | off | refresh: web search for the company JD while preparing the pack
RAG_WEB_SEARCH_MODE=auto

# --- Job Sync Service ---
JOB_SYNC_URL=http://127.0.0.1:8050

# --- Gateway ---
# production: refuses to start with the placeholder CORE_JWT_SECRET or CORS_ORIGINS=*
APP_ENV=development
# Browser origins allowed for CORS and WebSocket, comma-separated. In production list the UI address.
CORS_ORIGINS=*
# true only when a proxy in front (nginx) overwrites X-Forwarded-For; otherwise clients could fake it
TRUST_PROXY_HEADERS=false

# --- Sign-in ---
# off = no sign-in, everyone sees every session; open = any username, no password, one account per
# username (sessions, CVs, reports, streak are separated); student = student id (+ ACCESS_CODE), same as
# AUTH_REQUIRED=true. Open mode generates AUTH_JWT_SECRET next to DATABASE_PATH when it is empty.
AUTH_MODE=off
# true = every /api route and the WebSocket need a token from POST /api/auth/login, and a student only
# reaches their own sessions. Leave false until the frontend sends the token.
AUTH_REQUIRED=false
# At least 32 characters, different from CORE_JWT_SECRET.
# python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_TTL_SEC=28800
# Shared code the class must type to sign in. Empty = anyone who knows a student id can sign in.
ACCESS_CODE=
# Regex of student ids allowed to sign in, e.g. (SE|SS|AI)\d{6}. Empty = any id.
STUDENT_ID_PATTERN=
# Who owns which session (SQLite). The Docker image sets /data/gateway.db on a volume.
DATABASE_PATH=data/gateway.db

# --- Operations ---
# Token for GET /metrics. Empty = endpoint disabled.
METRICS_TOKEN=
# Per minute, 0 = off. Login and WebSocket limits are per client address; create is per student.
RATE_LOGIN_PER_MIN=60
RATE_CREATE_PER_MIN=6
RATE_WS_PER_MIN=120
QUOTA_SESSIONS_PER_DAY=0
# Required header X-Admin-Token for POST /api/sync, /api/job-sync and /api/scheduler/* when AUTH_REQUIRED=true.
# Empty = those routes are closed while sign-in is required.
ADMIN_TOKEN=
