# Copy these values into your .env and supply your actual provider configuration.
# Empty credentials intentionally disable execution rather than generate fake runs.
DOCKER_LLM_API_KEY=
DOCKER_LLM_API_URL=
DOCKER_LLM_MODEL=
# Optional Brave Search API key. Empty means no company-specific web research is available.
DOCKER_BRAVE_SEARCH_API_KEY=
RAG_WEB_SEARCH_ENABLED=true
RAG_WEB_SEARCH_PROVIDER=auto
BROWSERBASE_API_KEY=
RAG_WEB_SEARCH_TIMEOUT_SECONDS=10
RAG_WEB_SEARCH_MAX_RESULTS=4
RAG_WEB_SEARCH_MAX_PAGES=4
RAG_WEB_RESEARCH_CACHE_TTL_SECONDS=86400
# Development-only MinIO root credentials. Replace these before sharing the stack.
MINIO_ROOT_USER=dpl-pvan-local
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-secret
DPL_PVAN_PORT=8001
DPL_INSPECTOR_ENABLED=true
DPL_TEST_UI_ENABLED=true
DPL_INSPECTOR_LOCAL_AUTH=true
DPL_RETRIEVAL_BACKEND=rag
# Required only when starting with compose.rag.yaml. Use different random values.
RAG_IDQ_API_TOKEN=replace-with-a-long-random-idq-api-token
RAG_CORE_TOKEN=replace-with-a-different-long-random-core-token
# Optional knowledge-admin token (X-RAG-Admin-Token) for catalog imports and /rag/index; empty = closed.
RAG_KNOWLEDGE_ADMIN_TOKEN=
RAG_ADMIN_PASSWORD=local-rag-admin-change-me
